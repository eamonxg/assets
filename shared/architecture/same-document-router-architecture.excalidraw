    {
      "id": "step-6-body",
      "type": "text",
      "x": 1698,
      "y": 1502,
      "width": 585,
      "height": 94,
      "strokeColor": "#212529",
      "roughness": 0,
      "text": "intercept -> teardown -> resolve -> render\nFlush Poll, uci, listeners and modals; apply dispatcher rules;\nupdate L.env, page state, menus, breadcrumbs and tabs.",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-18T03:21:08.712Z",
