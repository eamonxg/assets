      "width": 570,
      "height": 30,
      "strokeColor": "#2f9e44",
      "roughness": 0,
      "text": "View data calls",
      "fontSize": 22,
      "fontFamily": 2,
      "createdAt": "2026-08-18T03:21:08.712Z",
      "updatedAt": "2026-08-18T03:21:08.712Z",
      "version": 1
    },
    {
      "id": "step-5-body",
      "type": "text",
      "x": 938,
      "y": 1502,
      "width": 585,
      "height": 94,
      "strokeColor": "#212529",
      "roughness": 0,
      "text": "The view's existing load() ubus calls stay on the device.\nSame work, same cost; they start 225 ms earlier.\nTeardown also performs one batched uci refill.",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-18T03:21:08.712Z",
      "updatedAt": "2026-08-18T03:21:08.712Z",
      "version": 1
    },
