      "version": 1
    },
    {
      "id": "step-2-title",
      "type": "text",
      "x": 938,
      "y": 1229,
      "width": 570,
      "height": 30,
      "strokeColor": "#e8590c",
      "roughness": 0,
      "text": "i18n catalog dispatch",
      "fontSize": 22,
      "fontFamily": 2,
      "createdAt": "2026-08-18T03:21:08.712Z",
      "updatedAt": "2026-08-18T03:21:08.712Z",
      "version": 1
    },
    {
      "id": "step-2-body",
      "type": "text",
      "x": 938,
      "y": 1272,
      "width": 585,
      "height": 94,
      "strokeColor": "#212529",
      "roughness": 0,
      "text": "A second CGI process runs admin/translations/<lang>.\nThe catalog is parser-blocking and uncacheable:\nno-cache, no ETag and no Last-Modified.\nThe dispatch cost dominates the payload size.",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-18T03:21:08.712Z",
      "updatedAt": "2026-08-18T03:21:08.712Z",
      "version": 1
    },
