    {
      "id": "step-3-title",
      "type": "text",
      "x": 1698,
      "y": 1229,
      "width": 570,
      "height": 30,
      "strokeColor": "#1971c2",
      "roughness": 0,
      "text": "Rebuild document shell",
      "fontSize": 22,
      "fontFamily": 2,
      "createdAt": "2026-08-18T03:21:08.712Z",
      "updatedAt": "2026-08-18T03:21:08.712Z",
      "version": 1
    },
    {
      "id": "step-3-body",
      "type": "text",
      "x": 1698,
      "y": 1272,
      "width": 585,
      "height": 94,
      "strokeColor": "#212529",
      "roughness": 0,
      "text": "The browser discards DOM, JS heap, timers and listeners;\nthen parses HTML, initializes LuCI and rebuilds navigation.\nThe shell is byte-identical to the previous one.",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-18T03:21:08.712Z",
      "updatedAt": "2026-08-18T03:21:08.712Z",
      "version": 1
    },
