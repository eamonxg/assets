      "isDeleted": false,
      "boundElements": null,
      "updated": 1787023266022,
      "link": null,
      "locked": false,
      "text": "“The device did not get faster.\nIt stopped being asked.”",
      "fontSize": 29,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“The device did not get faster.\nIt stopped being asked.”",
      "autoResize": true,
      "lineHeight": 1.15,
      "syncedAt": "2026-08-18T03:21:07.214Z",
      "source": "frontend_sync",
      "syncTimestamp": "2026-08-18T03:21:07.210Z",
      "updatedAt": "2026-08-18T03:21:08.769Z"
    },
