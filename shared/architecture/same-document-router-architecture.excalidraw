      "type": "text",
      "x": 178,
      "y": 1459,
      "width": 570,
      "height": 30,
      "strokeColor": "#1971c2",
      "roughness": 0,
      "text": "Render destination view",
      "fontSize": 22,
      "fontFamily": 2,
      "createdAt": "2026-08-18T03:21:08.712Z",
      "updatedAt": "2026-08-18T03:21:08.712Z",
      "version": 1
    },
    {
      "id": "step-4-body",
      "type": "text",
      "x": 178,
      "y": 1502,
      "width": 585,
      "height": 94,
      "strokeColor": "#212529",
      "roughness": 0,
      "text": "instantiateView() -> load() -> render() -> commit #view.\nThis is the only destination-specific step.\nThe view module and its data contract stay unchanged.",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-18T03:21:08.712Z",
      "updatedAt": "2026-08-18T03:21:08.712Z",
      "version": 1
    },
