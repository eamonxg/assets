    {
      "id": "step-1-title",
      "type": "text",
      "x": 178,
      "y": 1229,
      "width": 570,
      "height": 30,
      "strokeColor": "#e8590c",
      "roughness": 0,
      "text": "Page HTML dispatch",
      "fontSize": 22,
      "fontFamily": 2,
      "createdAt": "2026-08-18T03:21:08.712Z",
      "updatedAt": "2026-08-18T03:21:08.712Z",
      "version": 1
    },
    {
      "id": "step-1-body",
      "type": "text",
      "x": 178,
      "y": 1272,
      "width": 585,
      "height": 94,
      "strokeColor": "#212529",
      "roughness": 0,
      "text": "uhttpd forks /www/cgi-bin/luci.\nluci.dispatcher resolves menu, session and ACLs;\nview.ut -> header.ut renders the document shell.\nNo destination-specific data has loaded yet.",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-08-18T03:21:08.712Z",
      "updatedAt": "2026-08-18T03:21:08.712Z",
      "version": 1
    },
    {
      "id": "step-2-card",
      "type": "rectangle",
